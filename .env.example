# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas. Least-privilege DB user, strong password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=irminsul
# Tests use a separate database, dropped after each run.
MONGODB_TEST_DB=irminsul_test

# Auth. Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=<change-me>

# data.gov.in (Agmarknet) API key
DATA_GOV_IN_API_KEY=<your-key>

# Seed accounts password. Seed script never hard-codes passwords.
SEED_DEMO_PASSWORD=<change-me>

# development | production
ENVIRONMENT=development
